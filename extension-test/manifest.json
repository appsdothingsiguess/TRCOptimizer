{
  "manifest_version": 2,
  "name": "i3 Selector Tester",
  "version": "0.5.6",
  "description": "Throwaway diagnostic tool to validate i3 Flutter semantics selectors on ims.lisd.net",
  "permissions": [
    "*://ims.lisd.net/*",
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "i3 Selector Tester",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://ims.lisd.net/*"],
      "js": ["test-runner.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "i3-selector-test@lisd.internal",
      "strict_min_version": "126.0"
    }
  }
}
